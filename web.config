<?xml version="1.0" encoding="UTF-8"?>
<configuration><system.webServer><directoryBrowse enabled="false"/><rewrite><rules><rule name="Block WebGit private resources" stopProcessing="true"><match url="^(certificates|storage|workspace)(/.*)?$|^(config|app)\.php$" ignoreCase="true"/><action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden"/></rule></rules></rewrite></system.webServer></configuration>
